{
  "description": "Adds information about whether or not a game is on the list of Games that treat GOG customers as 2nd Class @ https://docs.google.com/spreadsheets/d/1zjwUN1mtJdCkgtTDRB2IoFp7PP41fraY-oFNY00fEkI/",
  "manifest_version": 2,
  "name": "GOG 2nd Class Helper",
  "version": "2.3",
  "homepage_url": "https://github.com/poacher2k/gog-2nd-class-ext",
  "browser_specific_settings": {
    "gecko": {
      "id": "{0c2c1d5d-7040-4499-9d29-bff606d963e6}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "permissions": [
    "storage",
    "https://docs.google.com/spreadsheets/d/14haGnU2kcY6wV6ssBeyW6_mMk6kkVqZX-QvMKlgXGu0/gviz/tq",
    "https://docs.google.com/spreadsheets/d/1pDO6WTHLHyrrtidQ1MAxW6u8j3BxUaGcFaJsVyWj2QY/gviz/tq"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.gog.com/*"
      ],
      "js": [
        "dist/app.js"
      ]
    }
  ]
}